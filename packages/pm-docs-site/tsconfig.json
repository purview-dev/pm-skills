{
	"extends": "astro/tsconfigs/strict",
	"compilerOptions": {
		"allowJs": false,
		"erasableSyntaxOnly": true,
		"jsx": "react-jsx",
		"jsxImportSource": "react",
		"types": ["bun"]
	},
	"include": ["**/*"],
	"exclude": ["dist", "node_modules", "test/fixtures/**/dist", "test/fixtures/**/.astro", "test/.tmp"]
}
