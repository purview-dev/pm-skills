---
// Every roadmap item in the plan, by state — in progress, Next, Later, Done
// and Dropped — from planning.json. Each item has its own page, which search indexes.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

import ExportStamp from '../../../components/ExportStamp.astro';
import FeatureTable from '../../../components/FeatureTable.astro';
import { FEATURE_STATES, features, loadPlanning, type FeatureState } from '../../../lib/planning';
import '../../../styles/components.css';

const planning = loadPlanning();
const all = features(planning);
const groups = (Object.keys(FEATURE_STATES) as FeatureState[]).map((state) => ({ state, items: all.filter((feature) => feature.state === state) }));
---

<StarlightPage frontmatter={{ title: 'Features', description: 'Every roadmap item: in progress, Next, Later, Done and Dropped.' }}>
	<ExportStamp />

	{
		groups.map((group) => (
			<section>
				<h2 id={group.state}>
					{FEATURE_STATES[group.state]} <span class="plan-count">{group.items.length}</span>
				</h2>
				<FeatureTable state={group.state} items={group.items} milestones={planning.strategy.milestones} />
			</section>
		))
	}
</StarlightPage>
