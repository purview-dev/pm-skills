---
// The parking lot from planning.json's `inbox`: the ideas waiting for a
// pm-shape discussion first, then the rest, one card per idea.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

import ExportStamp from '../../components/ExportStamp.astro';
import KanbanItemCard from '../../components/lib/KanbanItemCard.astro';
import LinkedText from '../../components/LinkedText.astro';
import RefLink from '../../components/RefLink.astro';
import { inboxHref, loadPlanning, severityToPriority, sourceInitials } from '../../lib/planning';
import '../../styles/components.css';

const planning = loadPlanning();
const groups = [
	{ title: 'To discuss', entries: planning.inbox.filter((entry) => entry.discuss === 'yes') },
	{ title: 'Parked', entries: planning.inbox.filter((entry) => entry.discuss !== 'yes') },
];
---

<StarlightPage frontmatter={{ title: 'Inbox', description: 'Parked ideas, bugs and questions, with those waiting for discussion first.', tableOfContents: false }}>
	<ExportStamp />

	<p>
		{planning.counts.openInbox} open, {planning.counts.discuss} to discuss, {planning.inbox.length} in all. Last review: {planning.checks.lastReview ?? 'never'}.
	</p>

	{
		groups.map((group) => (
			<section>
				<h2>
					{group.title} <span class="plan-count">{group.entries.length}</span>
				</h2>
				{group.entries.length === 0 && <p class="plan-empty">Nothing here</p>}
				<div class="plan-cards not-content">
					{group.entries.map((entry) => (
						<div>
							<KanbanItemCard
								title={entry.title}
								tag={entry.kind ?? 'idea'}
								assignee={sourceInitials(entry.source)}
								dueDate={entry.captured ?? ''}
								priority={severityToPriority(entry.severity)}
								commentsCount={0}
								attachmentsCount={0}
							/>
							<p class="plan-meta">
								<a href={inboxHref(entry.file)} title={entry.title}>
									Open
								</a>
							</p>
							{entry.affects && entry.affects !== 'none' && (
								<p class="plan-meta">
									Affects: <LinkedText text={entry.affects} />
								</p>
							)}
							{entry.related.length > 0 && (
								<p class="plan-meta">
									Related:{' '}
									{entry.related.map((ref, index) => (
										<>
											{index > 0 && ', '}
											<RefLink ref={ref} />
										</>
									))}
								</p>
							)}
							{entry.brief && (
								<p class="plan-meta">
									Brief: <RefLink ref={entry.brief} label="id" />
								</p>
							)}
							{entry.idea && (
								<p class="plan-meta">
									<LinkedText text={entry.idea} />
								</p>
							)}
						</div>
					))}
				</div>
			</section>
		))
	}
</StarlightPage>
