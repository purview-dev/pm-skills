---
// One ADR from planning.json's `adrs`: its status, header fields, and its four
// sections, each rendered by Astro from its `adr-sections` entry so relative
// images resolve (src/loaders/adrs.ts, ADR-012), with the IDs in them linked,
// and what links to it.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection, getEntry, render } from 'astro:content';

import ExportStamp from '../../../components/ExportStamp.astro';
import LinkedFrom from '../../../components/LinkedFrom.astro';
import LinkedHtml from '../../../components/LinkedHtml.astro';
import LinkedText from '../../../components/LinkedText.astro';
import RefLink from '../../../components/RefLink.astro';
import { loadPlanning } from '../../../lib/planning';
import type { Adr } from '../../../lib/planning-types';
import { ADR_SECTIONS, adrSectionId, hasContent } from '../../../loaders/adrs';
import '../../../styles/components.css';

export async function getStaticPaths() {
	// An empty collection is never looked up: Astro warns that it does not exist.
	if (loadPlanning().adrs.length === 0) return [];

	const entries = await getCollection('adrs');

	return entries.map((entry: { id: string; data: unknown }) => ({ params: { id: entry.id }, props: { adr: entry.data as Adr } }));
}

const { adr } = Astro.props as { adr: Adr };
// Each non-empty section's Content component (ADR-015); a missing section is left out and a blank one says so.
const sections = await Promise.all(
	ADR_SECTIONS.filter(({ key }) => adr[key] !== null).map(async ({ key, label }) => {
		const entry = hasContent(adr[key]) ? await getEntry('adr-sections', adrSectionId(adr.id, key)) : undefined;

		return { key, label, Content: entry ? (await render(entry)).Content : null };
	}),
);
const status = adr.status ?? 'unknown';
const refs: { label: string; ref: string | null }[] = [
	{ label: 'Item', ref: adr.item },
	{ label: 'Supersedes', ref: adr.supersedes },
	{ label: 'Superseded by', ref: adr.supersededBy },
];
---

<StarlightPage
	frontmatter={{ title: `${adr.id} ${adr.title}`, description: `${status} decision${adr.category ? `, ${adr.category}` : ''}.`, tableOfContents: false }}
>
	<ExportStamp kind="ADR" state={status} />

	<p>
		<span class={`adr-status adr-status--${status}`}>{status}</span>
		{' '}
		<a href="/plan/decisions/">All decisions</a>
	</p>

	<dl class="plan-facts">
		{adr.date && (
			<div>
				<dt>Date</dt>
				<dd>{adr.date}</dd>
			</div>
		)}
		{adr.category && (
			<div>
				<dt>Category</dt>
				<dd>{adr.category}</dd>
			</div>
		)}
		{
			refs
				.filter((entry) => entry.ref)
				.map((entry) => (
					<div>
						<dt>{entry.label}</dt>
						<dd>
							<RefLink ref={entry.ref} />
						</dd>
					</div>
				))
		}
		{adr.source && (
			<div>
				<dt>Source</dt>
				<dd>
					<LinkedText text={adr.source} />
				</dd>
			</div>
		)}
	</dl>

	{
		sections.map(({ label, Content }) => (
			<section>
				<h2>{label}</h2>
				{Content ? (
					<LinkedHtml>
						<Content />
					</LinkedHtml>
				) : (
					<p>None recorded.</p>
				)}
			</section>
		))
	}

	<LinkedFrom ref={adr.id} />
</StarlightPage>
