---
// The task board, column by column, from planning.json's `board.columns` —
// the same columns the pm-board skill renders — as a server-rendered React
// island (src/components/board/Board.tsx) that filters the cards and
// collapses columns. Each card links to its item's page; a plain click opens
// the item popup (src/scripts/plan.ts) from the templates below.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

import Board from '../../components/board/Board';
import ExportStamp from '../../components/ExportStamp.astro';
import ItemDetail from '../../components/ItemDetail.astro';
import ItemDialog from '../../components/ItemDialog.astro';
import PlanInteractions from '../../components/PlanInteractions.astro';
import { boardCards } from '../../lib/board-data';
import { loadPlanning } from '../../lib/planning';
import { siteRefs } from '../../lib/site-refs';
import '../../styles/components.css';
import '../../styles/kanban.css';

const planning = loadPlanning();
const { known } = await siteRefs();
const cards = boardCards(planning, known);
const milestones = planning.strategy.milestones.map(({ id, name }) => ({ id, name }));
// One popup template per item with a page, even when the same item is on two cards.
const details = [...new Set(cards.filter((card) => card.href && card.id).map((card) => card.id!))];
---

<StarlightPage
	frontmatter={{ title: 'Board', description: 'Now, Next, For you, Waiting and Done.', tableOfContents: false }}
>
	<ExportStamp />
	<PlanInteractions />

	<!-- `not-content`: Starlight's prose spacing would push every column after the first down. -->
	<div class="plan-columns not-content">
		<Board client:load cards={cards} milestones={milestones} />
	</div>

	{details.map((id) => <ItemDetail id={id} />)}
	<ItemDialog />
</StarlightPage>
