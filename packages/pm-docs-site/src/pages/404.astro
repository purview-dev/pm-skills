---
// The not-found page. Starlight's own 404 route is off (`disable404Route` in
// lib/index.ts): it reads a `404` entry from the docs collection, and Astro
// warns on every build when there is none, while a draft entry would print
// Starlight's "This content is a draft" notice on the live page. This page is
// Starlight's splash 404 without either: the same title and tagline, out of search.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
---

<StarlightPage
	frontmatter={{
		title: '404',
		template: 'splash',
		editUrl: false,
		pagefind: false,
		hero: { tagline: Astro.locals.t('404.text'), actions: [] },
	}}
/>
