---
// When the plan on this page was exported, and from which commit, so a stale
// planning.json is visible. Run the pm-export skill to refresh it.
//
// It also labels the page for search: Pagefind reads the hidden filter spans
// (Kind, and for an item its State and Milestone) and offers them as filters.
import config from 'virtual:pm-docs-site/config';

import { loadPlanning } from '../lib/planning';

interface Props {
	/** The search filter `Kind`: `Plan` for a plan page, `Feature` or `Milestone` for an item's or a milestone's page. */
	kind?: string;
	state?: string;
	milestone?: string;
}

const { kind = 'Plan', state, milestone } = Astro.props;
const planning = loadPlanning();
const exported = planning.generatedAt.replace('T', ' ').slice(0, 16);
const head = planning.source.head?.slice(0, 7) ?? 'unknown';
---

<p class="export-stamp" data-pagefind-ignore>
	Plan exported {exported} from {planning.source.branch ?? 'a detached HEAD'} at <code>{head}</code> ({config.planningLabel}).
</p>
<span hidden data-pagefind-filter={`Kind:${kind}`}></span>
{state && <span hidden data-pagefind-filter={`State:${state}`}></span>}
{milestone && <span hidden data-pagefind-filter={`Milestone:${milestone}`}></span>}
