---
// One item's summary: state, milestone, facts, Done when, related items, brief
// and risks. The feature page shows it, and so does the item popup on the
// Board and Roadmap, so the two never drift.
import { briefOf, dependents, features, loadPlanning, planProgress } from '../lib/planning';
import LinkedText from './LinkedText.astro';
import RefLink from './RefLink.astro';
import StateBadge from './StateBadge.astro';

interface Props {
	id: string;
}

const planning = loadPlanning();
const all = features(planning);
const feature = all.find((candidate) => candidate.id === Astro.props.id)!;
const byId = new Map(all.map((candidate) => [candidate.id, candidate]));
const brief = briefOf(planning, feature);
const blocks = dependents(all, feature.id);
const revisedBy = all.filter((candidate) => candidate.revisits === feature.id);
const risks = [...planning.risks.open, ...planning.risks.closed].filter((risk) => risk.affects === feature.id);
const plan = feature.state === 'now' ? planning.plan : null;

const facts: { label: string; value: string }[] = [
	{ label: 'Owner', value: feature.owner ?? '–' },
	{ label: 'Size', value: feature.size ?? '–' },
	...(feature.state === 'next' || feature.state === 'later' ? [{ label: 'Position', value: `${feature.state === 'next' ? 'Next' : 'Later'} ${feature.position}` }] : []),
	...(feature.status
		? [{ label: 'Status', value: [feature.status.value, feature.status.reason, feature.status.since && `since ${feature.status.since}`].filter(Boolean).join(', ') }]
		: []),
	...(feature.stage ? [{ label: 'Stage', value: feature.stage }] : []),
	...(feature.started ? [{ label: 'Started', value: feature.started }] : []),
	...(plan ? [{ label: 'Plan steps', value: `${plan.checked} of ${plan.total} (${planProgress(plan)}%)` }] : []),
	...(feature.date ? [{ label: feature.state === 'done' ? 'Done' : 'Dropped', value: feature.date }] : []),
];
---

<p>
	<StateBadge state={feature.state} />
	{
		(feature.label === 'blocked' || feature.label === 'waiting') && (
			<>
				{' '}
				<StateBadge label={feature.label} />
			</>
		)
	}
	{' '}
	<RefLink ref={feature.milestone ?? 'none'} />
</p>

<dl class="plan-facts">
	{
		facts.map((fact) => (
			<div>
				<dt>{fact.label}</dt>
				<dd>
					<LinkedText text={fact.value} />
				</dd>
			</div>
		))
	}
</dl>

{
	feature.doneWhen.length > 0 && (
		<section>
			<h2>Done when</h2>
			<ul>
				{feature.doneWhen.map((check) => (
					<li>
						<LinkedText text={check} />
					</li>
				))}
			</ul>
		</section>
	)
}

{
	(feature.dependsOn.length > 0 || blocks.length > 0 || feature.revisits || revisedBy.length > 0) && (
		<section>
			<h2>Related items</h2>
			<ul>
				{feature.dependsOn.map((dep) => (
					<li>
						Depends on <RefLink ref={dep} /> {byId.get(dep) && <StateBadge state={byId.get(dep)!.state} />}
					</li>
				))}
				{blocks.map((other) => (
					<li>
						Needed by <RefLink ref={other.id} /> <StateBadge state={other.state} />
					</li>
				))}
				{feature.revisits && (
					<li>
						Revisits <RefLink ref={feature.revisits} />
					</li>
				)}
				{revisedBy.map((other) => (
					<li>
						Revised by <RefLink ref={other.id} />
					</li>
				))}
			</ul>
		</section>
	)
}

{
	(brief || feature.brief) && (
		<section>
			<h2>Brief</h2>
			{brief ? (
				<>
					<p>
						<strong>{brief.title}</strong> — {brief.status ? <LinkedText text={brief.status} /> : 'no status'}
						{brief.updated && <>, updated {brief.updated}</>}
					</p>
					{brief.problem && (
						<p>
							Problem: <LinkedText text={brief.problem} />
						</p>
					)}
					{brief.decision && (
						<p>
							Decision: <LinkedText text={brief.decision} />
						</p>
					)}
					<p>
						<RefLink ref={brief.path} label="id" />
					</p>
				</>
			) : (
				<p>
					<code>{feature.brief}</code>
				</p>
			)}
		</section>
	)
}

{
	risks.length > 0 && (
		<section>
			<h2>Risks</h2>
			<ul>
				{risks.map((risk) => (
					<li>
						<span class={`rag rag--${risk.rag}`}>{risk.rag}</span>{' '}
						<strong>
							<RefLink ref={risk.id} label="id" />
						</strong>{' '}
						<LinkedText text={risk.title} /> — {risk.status}
					</li>
				))}
			</ul>
		</section>
	)
}
