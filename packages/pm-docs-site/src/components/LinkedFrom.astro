---
// The pages that link to one item, milestone or risk, grouped by how they
// link. Derived from planning.json (references), so search ignores it.
import { RELATION_LABELS, type Relation } from '../lib/references';
import { siteRefs } from '../lib/site-refs';

interface Props {
	ref: string;
}

const links = (await siteRefs()).back.get(Astro.props.ref) ?? [];
const groups = (Object.keys(RELATION_LABELS) as Relation[])
	.map((relation) => ({ relation, links: links.filter((link) => link.relation === relation) }))
	.filter((group) => group.links.length > 0);
---

<section class="linked-from" data-linked-from data-pagefind-ignore>
	<h2>Linked from</h2>
	{groups.length === 0 && <p class="plan-empty">Nothing links here yet.</p>}
	{
		groups.map((group) => (
			<>
				<h3>{RELATION_LABELS[group.relation]}</h3>
				<ul>
					{group.links.map((link) => (
						<li>
							<a href={link.href}>{link.label}</a>
						</li>
					))}
				</ul>
			</>
		))
	}
</section>
