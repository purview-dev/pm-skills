---
// The Board's and Roadmap's client script (src/scripts/plan.ts, the item
// popup). The inline part runs as the page is parsed, before the Board's
// columns paint, so a collapsed column never flashes open and a filtered link
// never shows the unfiltered board; it must stay in step with STORAGE_KEY in
// src/components/board/Board.tsx and BOARD_KEYS in src/lib/board.ts. Only the
// Board page passes `board`, so the pending mark is never set elsewhere.
interface Props {
	board?: boolean;
}

const { board = false } = Astro.props;
---

<script is:inline define:vars={{ board }}>
	try {
		const names = JSON.parse(localStorage.getItem('pm-docs-site:board:collapsed') ?? '[]');

		if (Array.isArray(names)) document.documentElement.dataset.boardCollapsed = names.filter((name) => typeof name === 'string').join(' ');
	} catch {
		// Junk or no storage: every column stays open.
	}

	// A board key in the URL: hide the Board's body until the island has
	// rendered that state and deleted the mark (useBoardUrlState.ts), so a
	// filtered link never shows the unfiltered board first.
	// A block, so the binding stays out of the page's global scope.
	{
		const params = new URLSearchParams(location.search);

		if (board && ['owner', 'milestone', 'size', 'rag', 'group'].some((key) => params.has(key))) document.documentElement.dataset.boardPending = '';
	}
</script>
<script>
	import '../scripts/plan.ts';
</script>
