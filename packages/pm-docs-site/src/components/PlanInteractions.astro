---
// The Board's and Roadmap's client script (src/scripts/plan.ts, the item
// popup). The inline part runs as the page is parsed, before the Board's
// columns paint, so a collapsed column never flashes open; it must stay in
// step with STORAGE_KEY in src/components/board/Board.tsx.
---

<script is:inline>
	try {
		const names = JSON.parse(localStorage.getItem('pm-docs-site:board:collapsed') ?? '[]');

		if (Array.isArray(names)) document.documentElement.dataset.boardCollapsed = names.filter((name) => typeof name === 'string').join(' ');
	} catch {
		// Junk or no storage: every column stays open.
	}
</script>
<script>
	import '../scripts/plan.ts';
</script>
