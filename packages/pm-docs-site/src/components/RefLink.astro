---
// One item, milestone, risk or brief as a link to its page, named with its
// title, or as plain text when that page is not built. An unknown key prints
// the fallback the caller gives (an entry title, `No milestone`), else the key.
import { refText } from '../lib/references';
import { siteRefs } from '../lib/site-refs';

interface Props {
	/** An ID (`R-012`, `M1`, `RK-002`), `none` for the No-milestone page, or a brief path. */
	ref: string | null | undefined;
	/** `full` shows the target's label (`R-012 Invoice export`); `id` the key only. */
	label?: 'full' | 'id';
	/** The text for a key with no target. */
	fallback?: string;
}

const { ref, label = 'full', fallback } = Astro.props;
const target = ref ? (await siteRefs()).known.get(ref) : undefined;
const text = refText(target, ref, label, fallback);
---

{target?.href ? <a href={target.href} title={target.label}>{text}</a> : text}
