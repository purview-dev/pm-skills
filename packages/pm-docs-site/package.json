{
	"name": "@purview-dev/pm-docs-site",
	"version": "0.1.0-pre.2",
	"type": "module",
	"description": "A local, searchable project site for pm-skills: the board, roadmap, milestones, features, log, and risks from pm-export's planning.json, with the repository's Markdown, as an Astro and Starlight integration.",
	"license": "MIT",
	"author": {
		"name": "Kieron Lanning",
		"url": "https://kieronlanning.dev/"
	},
	"homepage": "https://purview.dev/projects/pm-skills/",
	"bugs": {
		"url": "https://github.com/purview-dev/pm-skills/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/purview-dev/pm-skills.git",
		"directory": "packages/pm-docs-site"
	},
	"keywords": [
		"pm-skills",
		"project-management",
		"roadmap",
		"kanban",
		"documentation",
		"astro",
		"astro-integration",
		"withastro",
		"starlight"
	],
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=24"
	},
	"bin": {
		"pm-docs-site": "./dist/cli.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": ["dist", "src", "lib/repo-docs.ts", "lib/schema-version.ts", "README.md", "LICENSE.md"],
	"scripts": {
		"build": "node scripts/build.ts",
		"prepack": "node scripts/build.ts && node scripts/check-exports.ts",
		"test": "bun test",
		"check": "astro-check --root .",
		"test:browser": "playwright test"
	},
	"dependencies": {
		"@astrojs/react": "7.1.9",
		"@astrojs/starlight": "0.42.10",
		"astro": "7.4.8",
		"react": "19.3.1",
		"react-dom": "19.3.1"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.12",
		"@playwright/test": "1.65.1",
		"@types/bun": "1.4.4",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"typescript": "6.0.3"
	}
}
