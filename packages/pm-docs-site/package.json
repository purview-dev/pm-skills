{
	"name": "@purview-dev/pm-docs-site",
	"version": "0.1.0-pre.1",
	"type": "module",
	"description": "A local, searchable project site for pm-skills: the board, roadmap, milestones, features, log, and risks from pm-export's planning.json, with the repository's Markdown, as an Astro and Starlight integration.",
	"license": "MIT",
	"author": {
		"name": "Kieron Lanning",
		"url": "https://kieronlanning.dev/"
	},
	"homepage": "https://purview.dev/projects/pm-skills/",
	"bugs": {
		"url": "https://github.com/purview-dev/pm-skills/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/purview-dev/pm-skills.git",
		"directory": "packages/pm-docs-site"
	},
	"keywords": [
		"pm-skills",
		"project-management",
		"roadmap",
		"kanban",
		"documentation",
		"astro",
		"astro-integration",
		"withastro",
		"starlight"
	],
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=22"
	},
	"bin": {
		"pm-docs-site": "./cli.mjs"
	},
	"exports": {
		".": {
			"types": "./index.d.ts",
			"default": "./index.mjs"
		}
	},
	"files": ["index.mjs", "index.d.ts", "cli.mjs", "lib", "src", "README.md", "LICENSE.md"],
	"scripts": {
		"prepublishOnly": "node scripts/check-exports.mjs",
		"test": "bun test",
		"check": "astro-check --root .",
		"test:browser": "playwright test"
	},
	"dependencies": {
		"@astrojs/starlight": "0.42.10",
		"astro": "7.4.8"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.12",
		"@playwright/test": "1.65.1",
		"@types/bun": "1.4.4",
		"typescript": "6.0.3"
	}
}
