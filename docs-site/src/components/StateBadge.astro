---
// An item's state (In progress, Next, Later, Done, Dropped) or its roadmap
// label (blocked, waiting) as a badge that always prints the word.
import { FEATURE_STATES, type FeatureState } from '../lib/planning';

interface Props {
	state?: FeatureState;
	label?: 'blocked' | 'waiting';
}

const { state, label } = Astro.props;
---

{state && <span class={`state state--${state}`}>{FEATURE_STATES[state]}</span>}
{label && <span class={`state state--${label}`}>{label}</span>}
