---
// The task board, column by column, from planning.json's `board.columns` —
// the same columns the pm-board skill renders.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

import ExportStamp from '../../components/ExportStamp.astro';
import KanbanItemCard from '../../components/lib/KanbanItemCard.astro';
import TaskKanbanCard from '../../components/lib/TaskKanbanCard.astro';
import { initials, loadPlanning, sizeToPriority } from '../../lib/planning';
import type { Card } from '../../lib/planning-types';
import '../../styles/components.css';

const planning = loadPlanning();
const { columns } = planning.board;

// The roadmap item behind a card, for its milestone.
const items = new Map([...planning.roadmap.next, ...planning.roadmap.later].map((item) => [item.id, item]));
const milestoneOf = (card: Card) => items.get(card.id)?.milestone ?? 'No milestone';

const progress = planning.plan && planning.plan.total > 0 ? Math.round((planning.plan.checked / planning.plan.total) * 100) : 0;
const taskPriority = (size: Card['size']) => ({ low: 'low', medium: 'med', high: 'high' } as const)[sizeToPriority(size)];

const queued = [
	{ title: 'Next', cards: columns.next },
	{ title: 'For you', cards: columns.foryou },
	{ title: 'Waiting', cards: columns.waiting },
];
---

<StarlightPage
	frontmatter={{ title: 'Board', description: 'Now, Next, For you, Waiting and Done.', tableOfContents: false }}
>
	<ExportStamp />

	<!-- `not-content`: Starlight's prose spacing would push every column after the first down. -->
	<div class="plan-columns not-content">
		<section class="plan-column" aria-labelledby="col-now">
			<h2 id="col-now">Now <span>{columns.now.length}</span></h2>
			{columns.now.length === 0 && <p class="plan-empty">Nothing here</p>}
			{
				columns.now.map((card) => (
					<TaskKanbanCard
						task={`${card.id} ${card.title}`}
						date={planning.now.started ?? ''}
						assigneeInitials={initials(card.owner)}
						priority={taskPriority(card.size)}
						progress={progress}
					/>
				))
			}
		</section>

		{
			queued.map((column) => (
				<section class="plan-column" aria-label={column.title}>
					<h2>
						{column.title} <span>{column.cards.length}</span>
					</h2>
					{column.cards.length === 0 && <p class="plan-empty">Nothing here</p>}
					{column.cards.map((card) => (
						<KanbanItemCard
							title={`${card.id} ${card.title}`}
							tag={milestoneOf(card)}
							assignee={initials(card.owner)}
							dueDate={card.detail ?? ''}
							priority={sizeToPriority(card.size)}
							commentsCount={0}
							attachmentsCount={0}
						/>
					))}
				</section>
			))
		}

		<section class="plan-column" aria-labelledby="col-done">
			<h2 id="col-done">Done <span>{columns.done.length}</span></h2>
			{columns.done.length === 0 && <p class="plan-empty">Nothing here</p>}
			{
				columns.done.map((entry) => (
					// The result can run to a paragraph; it is on the Log page, not squeezed into a tag.
					<KanbanItemCard
						title={entry.id ? `${entry.id} ${entry.title}` : entry.title}
						tag={entry.milestone && entry.milestone !== 'none' ? entry.milestone : 'No milestone'}
						assignee={initials(entry.owner)}
						dueDate={entry.date}
						priority="low"
						commentsCount={0}
						attachmentsCount={0}
					/>
				))
			}
		</section>
	</div>
</StarlightPage>

<style is:global>
	/* The board uses the full content width, not a prose column. Astro may bundle this with
	   other pages' styles, so it applies only where a board is on the page. */
	:root:has(.plan-columns) {
		--sl-content-width: 100%;
	}
</style>
