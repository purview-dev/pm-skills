---
// The site's front page: where the project is, from planning.json, and the
// way into the plan and any optional modules (src/modules.ts).
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

import ExportStamp from '../components/ExportStamp.astro';
import { loadPlanning } from '../lib/planning';
import { modules } from '../modules';
import '../styles/components.css';

const planning = loadPlanning();
const { counts, checks } = planning;
const items = new Map([...planning.roadmap.next, ...planning.roadmap.later].map((item) => [item.id, item]));

const figures = [
	{ label: 'In Next', value: `${counts.next} of ${counts.nextMax}` },
	{ label: 'In Later', value: counts.later },
	{ label: 'Done', value: counts.done },
	{ label: 'Open ideas', value: counts.openInbox },
	{ label: 'Blocked', value: counts.blockers },
	{ label: 'Red risks', value: `${counts.redRisks} of ${counts.openRisks}` },
];

const redRisks = planning.risks.open.filter((risk) => risk.rag === 'red');
---

<StarlightPage
	frontmatter={{
		title: 'pm-skills project',
		description: 'The plan for pm-skills, from planning/planning.json, with every skill and its references.',
		template: 'splash',
	}}
>
	<ExportStamp />

	<section>
		<h2>Focus</h2>
		<p><strong>{planning.strategy.focus.milestone ?? 'No focus set'}</strong></p>
		{planning.strategy.focus.whyNow && <p>{planning.strategy.focus.whyNow}</p>}
		<p>
			{
				planning.now.item ? (
					<>
						Now: <strong>{planning.now.item.id} {planning.now.item.title}</strong> ({planning.now.stage})
					</>
				) : (
					'Nothing is in progress.'
				)
			}
		</p>
	</section>

	<section>
		<h2>Figures</h2>
		<dl class="home-figures">
			{
				figures.map((figure) => (
					<div>
						<dt>{figure.label}</dt>
						<dd>{figure.value}</dd>
					</div>
				))
			}
		</dl>
	</section>

	<section>
		<h2>Ready to start</h2>
		{checks.claimable.length === 0 && <p class="plan-empty">Nothing in Next can be started.</p>}
		<ul>
			{
				checks.claimable.map((id) => (
					<li>
						<strong>{id}</strong> {items.get(id)?.title}
					</li>
				))
			}
		</ul>
	</section>

	<section>
		<h2>Red risks</h2>
		{redRisks.length === 0 && <p class="plan-empty">No open risk is red.</p>}
		<ul>
			{
				redRisks.map((risk) => (
					<li>
						<span class="rag rag--red">red</span> <a href={`/plan/risks/#${risk.id.toLowerCase()}`}><strong>{risk.id}</strong></a>{' '}
						{risk.title} — mitigation: {risk.mitigation ?? 'none'}
					</li>
				))
			}
		</ul>
	</section>

	<section>
		<h2>Read on</h2>
		<ul>
			<li><a href="/plan/board/">Board</a> — Now, Next, For you, Waiting and Done</li>
			<li><a href="/plan/roadmap/">Roadmap</a> — milestones in order</li>
			<li><a href="/plan/log/">Log</a> — done, dropped and reviews</li>
			<li><a href="/plan/risks/">Risks</a> — the risk register by RAG status</li>
			{modules.architecture && <li><a href="/architecture/overview/">Architecture</a> — the LikeC4 views</li>}
			{modules.repoDocs && <li>Documentation — the repository's Markdown, grouped in the sidebar</li>}
		</ul>
	</section>
</StarlightPage>

<style>
	.home-figures {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
		gap: 0.75rem;
	}

	.home-figures > div {
		padding: 0.75rem 1rem;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 10px;
	}

	.home-figures dt {
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
	}

	.home-figures dd {
		margin: 0;
		font-size: var(--sl-text-2xl);
		font-weight: 700;
	}
</style>
