        }
      }
    },
    "id": {
      "type": "string",
      "pattern": "^R-[0-9]{3,}$"
    },
    "planStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "checked"
      ],
      "properties": {
